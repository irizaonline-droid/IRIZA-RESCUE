{
  "name": "iriza-rescue",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "demo": "node scripts/demo.mjs",
    "check": "node scripts/check.mjs",
    "docs": "node scripts/generate-docs.mjs",
    "evaluate": "node scripts/evaluate-studio.mjs",
    "build:editor": "esbuild src/editor-entry.mjs --bundle --minify --outfile=public/editor-bundle.js"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@vercel/sandbox": "^3.9.0",
    "codemirror": "^6.0.2"
  },
  "overrides": {
    "@vercel/cli-config": {
      "zod": "^4.6.7"
    }
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
