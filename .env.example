PORT=4310
# Generated locally on first start when omitted. Never commit the real .env.
RESCUE_API_TOKEN=
# Optional: enables actual Meta requests. No credentials are copied from IRIZA.
MODEL_API_KEY=
META_MODEL=muse-spark-1.3

# Optional repository-scoped GitHub credential for private metadata/commit access.
RESCUE_GITHUB_TOKEN=


# Optional isolated customer runtime (server-side only; never sent to VM)
RESCUE_VERCEL_TOKEN=
RESCUE_VERCEL_TEAM_ID=
RESCUE_VERCEL_PROJECT_ID=

# Shared IRIZA identity; only these accounts may access this administrator workspace.
RESCUE_ALLOWED_EMAILS=
# Enable only behind the verified HTTPS reverse proxy after identity verification.
RESCUE_PUBLIC_ORIGIN=

# Dedicated deployment options; operator mode retains bearer-token access control.
RESCUE_AUTH_MODE=accounts
RESCUE_DATA_DIR=
RESCUE_RELEASE=

# Trusted sample worker cap on constrained hosting; not a customer-code runner.
RESCUE_MAX_SAMPLE_WORKERS=3

# Source-copy budgets (MB); restart after changing. Archive transport limits remain.
RESCUE_SOURCE_MAX_MB=64
RESCUE_SOURCE_FILE_MAX_MB=4
